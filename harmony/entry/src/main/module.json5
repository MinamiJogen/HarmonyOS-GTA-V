{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      { "name": "ohos.permission.VIBRATE" },
      { "name": "ohos.permission.GYROSCOPE" }
    ],
    "metadata": [
      { "name": "ohos.arkui.UIMaterial.state", "value": "enable" }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:module_desc",
        "icon": "$media:app_icon_gta5_layered",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon_gta5",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      },
      {
        "name": "GraphicsFrameProbeAbility",
        "srcEntry": "./ets/graphicsframeprobe/GraphicsFrameProbeAbility.ets",
        "description": "$string:module_desc",
        "icon": "$media:app_icon_gta5_layered",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon_gta5",
        "startWindowBackground": "$color:start_window_background",
        "exported": true
      }
    ]
  }
}
