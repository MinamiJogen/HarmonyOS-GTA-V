{
  "playable_defaults_version": 1,
  "graphics_profile_version": 1,
  "graphics_preset": "medium",
  "scale": 1,
  "fps_limit": 24,
  "fullscreen": true,
  "texture_quality": 1,
  "no_msaa": true,
  "extra_args": [
    "-textureQuality=1",
    "-shaderQuality=1",
    "-shadowQuality=0",
    "-shadowSoftness=1",
    "-reflectionQuality=0",
    "-reflectionMSAA=0",
    "-multiSample=0",
    "-multiSampleQuality=0",
    "-samplingMode=0",
    "-txaa=0",
    "-reflectionBlur=1",
    "-fxaa=1",
    "-anisotropicQualityLevel=4",
    "-SSAO=0",
    "-particleQuality=0",
    "-waterQuality=0",
    "-grassQuality=1",
    "-postFX=0",
    "-tessellation=0",
    "-lodScale=0.1",
    "-pedLodBias=0",
    "-vehicleLodBias=0",
    "-cityDensity=0",
    "-pedVariety=1",
    "-vehicleVariety=1",
    "-MaxLODScale=0",
    "-MotionBlurStrength=0",
    "-ultraShadows=0",
    "-particleShadows=0",
    "-shadowLongShadows=0",
    "-shadowDistance=1",
    "-shadowDisableScreenSizeCheck=0",
    "-shadowSplitZStart=0.93",
    "-shadowSplitZEnd=0.89",
    "-shadowAircraftWeight=0.99",
    "-fogVolumes=0",
    "-HDStreamingInFlight=0",
    "-noInGameDOF=0"
  ],
  "thread_qos": true,
  "depth_reduce_opt": true,
  "depth_reduce_no_zero": true,
  "readback_pool": true,
  "luminance_no_zero": true,
  "spatial_upscale_enabled": true,
  "spatial_upscale_mode": "native_quality",
  "spatial_upscale_match_display": true,
  "spatial_upscale_native_short_edge": 800,
  "spatial_upscale_output_short_edge": 1080,
  "spatial_upscale_sharpness": 0.1,
  "frame_interpolation_enabled": true,
  "frame_interpolation_output_fps": 40,
  "frame_interpolation_classifier_policy": "observe_only"
}
