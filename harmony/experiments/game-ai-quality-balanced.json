{
  "playable_defaults_version": 1,
  "scale": 1.0,
  "fps_limit": 24,
  "fullscreen": true,
  "start_mode": 2,
  "mouse_sensitivity": 2.0,
  "mute": false,
  "no_astc": false,
  "extra_args": [
    "-shadowQuality=1",
    "-reflectionQuality=0",
    "-fxaa=1",
    "-anisotropicQualityLevel=4",
    "-shadowSoftness=1",
    "-lodScale=0.15"
  ],
  "cpu_profile": false,
  "gpu_diagnostics": false,
  "gpu_profile": false,
  "sync_submit": false,
  "thread_qos": true,
  "depth_reduce_opt": true,
  "depth_reduce_no_zero": true,
  "luminance_no_zero": true,
  "spatial_upscale_mode": "native_quality",
  "spatial_upscale_match_display": true,
  "spatial_upscale_sharpness": 0.1,
  "frame_interpolation_output_fps": 48,
  "frame_interpolation_classifier_policy": "observe_only",
  "frame_interpolation_slow_trace": false,
  "frame_interpolation_native_render_audit": false,
  "spatial_upscale_native_short_edge": 800,
  "spatial_upscale_output_short_edge": 1080
}
